{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/access.md)",
      "Read(**/_private/secrets/**)",
      "Read(**/.cursor/mcp.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/access.md)",
      "Edit(**/_private/secrets/**)",
      "Edit(**/.cursor/mcp.json)",
      "Bash(cat *.env*)",
      "Bash(cat *access.md*)",
      "Bash(cat *mcp.json*)",
      "Bash(type *.env*)",
      "Bash(type *access.md*)",
      "Bash(grep * .env*)",
      "Bash(grep * *access.md*)",
      "Bash(rg * .env*)",
      "Bash(rg * *access.md*)",
      "Bash(sed * .env*)",
      "Bash(head * .env*)",
      "Bash(tail * .env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *access.md*)",
      "PowerShell(Get-Content *mcp.json*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(Select-String * *.env*)",
      "PowerShell(Select-String * *access.md*)"
    ]
  }
}
