#!/bin/sh
root=$(git rev-parse --show-toplevel)
script="$root/.agents/tools/check_mdx_encoding.py"
if command -v python >/dev/null 2>&1; then
  python "$script" --fix-dirty || exit 1
elif command -v py >/dev/null 2>&1; then
  py -3 "$script" --fix-dirty || exit 1
else
  echo "check_mdx_encoding: python not found" >&2
  exit 1
fi
